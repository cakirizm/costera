# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (docker-compose provides one on port 5433)
DATABASE_URL="postgresql://costera:costera_dev_pw@localhost:5433/costera?schema=public"

# Auth.js (NextAuth v5) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
AUTH_TRUST_HOST=true

# Base URL used in password-reset links
APP_URL="http://localhost:3000"

# SMTP (optional) — when set, password-reset emails are sent for real.
# Leave SMTP_HOST empty in dev to log the reset link to the console instead.
# SMTP_HOST="smtp.your-provider.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="COSTERA <no-reply@yourdomain.com>"

# Demo request notification recipient (optional, defaults to SMTP_FROM or sales@costera.app)
# DEMO_NOTIFY_EMAIL="sales@yourdomain.com"
