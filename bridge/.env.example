# Where the COSTERA server lives.
COSTERA_URL=http://localhost:3000

# Issued once, in Dashboard > Integrations > Terminals & print bridge.
# Stored on the server only as a SHA-256 digest, so keep this copy.
COSTERA_DEVICE_TOKEN=replace-me

# How the bridge reaches the printer:
#   network  - raw ESC/POS over TCP, the usual port 9100 (set PRINTER_HOST)
#   file     - append the byte stream to a file; used for setup and testing
#   stdout   - print a human-readable rendering; used for setup and testing
PRINTER_TRANSPORT=stdout
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_FILE=./printer-out.bin

# Characters per line. 32 for 58mm paper, 42 or 48 for 80mm.
PRINTER_COLUMNS=42

# Pulse the cash drawer after a receipt (it hangs off the printer).
OPEN_DRAWER_ON_RECEIPT=true

# Seconds between polls when the queue is empty.
POLL_SECONDS=3
