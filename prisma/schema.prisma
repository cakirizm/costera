generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  KITCHEN
  FINANCE
}

enum DataSourceKind {
  DEMO
  IMPORT
  POS_API
}

enum ExpenseCategory {
  RENT
  UTILITIES
  PAYROLL
  DELIVERY_FEES
  MARKETING
  OTHER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  resetTokens  PasswordResetToken[]
  mobileSessions MobileSession[]
}

model Restaurant {
  id                String         @id @default(cuid())
  name              String
  city              String?
  currency          String         @default("USD")
  targetFoodCostPct Float          @default(25)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  memberships       Membership[]
  dataSource        DataSource?
  ingredients       Ingredient[]
  menuItems         MenuItem[]
  sales             Sale[]
  inventory         InventoryRow[]
  expenses          Expense[]
}

model Expense {
  id           String          @id @default(cuid())
  restaurantId String
  category     ExpenseCategory
  label        String
  amount       Float
  incurredOn   DateTime
  createdAt    DateTime        @default(now())
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model DataSource {
  id           String         @id @default(cuid())
  restaurantId String         @unique
  kind         DataSourceKind
  provider     String
  periodFrom   DateTime
  periodTo     DateTime
  syncedAt     DateTime       @default(now())
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id           String     @id @default(cuid())
  restaurantId String
  extId        String
  name         String
  unit         String
  unitCost     Float
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, extId])
}

model MenuItem {
  id           String       @id @default(cuid())
  restaurantId String
  extId        String
  name         String
  sellingPrice Float
  recipeLines  RecipeLine[]
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, extId])
}

model RecipeLine {
  id              String   @id @default(cuid())
  menuItemId      String
  ingredientExtId String
  quantity        Float
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String     @id @default(cuid())
  restaurantId  String
  menuItemExtId String
  quantity      Float
  channel       String
  locationId    String
  netSales      Float?
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model InventoryRow {
  id              String     @id @default(cuid())
  restaurantId    String
  ingredientExtId String
  openingQty      Float
  purchasesQty    Float
  transferInQty   Float      @default(0)
  transferOutQty  Float      @default(0)
  closingQty      Float
  knownWasteQty   Float      @default(0)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, ingredientExtId])
}

model Membership {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  role         Role       @default(OWNER)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Opaque, read-only native sessions. Only a SHA-256 token digest is stored.
model MobileSession {
  id                String   @id @default(cuid())
  userId            String
  tokenHash         String   @unique
  credentialVersion String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

// Shared across backend processes; login limits must not depend on one server's memory.
model MobileLoginWindow {
  id        String @id
  attempts  Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
